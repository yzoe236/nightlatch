{
  "manifest_version": 3,
  "key": "",
  "name": "Nightlatch — Profile Lock for Google Chrome™",
  "short_name": "Nightlatch",
  "version": "0.4.0",
  "description": "Password-lock your Chrome profile on shared computers. The lock state never syncs — unlocking at home never unlocks the lab machine.",
  "permissions": ["storage", "idle", "tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["themes.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nightlatch — lock this profile",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "lock-now": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Lock now"
    }
  }
}
